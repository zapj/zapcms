{
  "repositories": [
        {
            "type": "vcs",
            "url": "https://github.com/zapj/zap-php-framework.git"
        }
  ],
  "name": "zapj/zapcms",
  "description": "A simple CMS based on zap-php-framework",
  "type": "project",
  "support": {
    "email": "zapcms@zap.cn",
    "docs": "https://zap.cn/docs/zapcms-docs"
  },
  "require": {
    "php": ">=7.4",
    "zapj/zap-php-framework": "dev-main",
    "ext-pdo": "*",
    "ext-gd": "*",
    "monolog/monolog": "^2.9",
    "ext-json": "*",
    "ezyang/htmlpurifier": "dev-master",
    "phpmailer/phpmailer": "dev-master",
    "overtrue/pinyin": "^3.0"
  },
  "autoload": {
    "files":[
      "app/zapcms/functions.php"
    ],
    "psr-4":{
      "app\\" :"app/",
      "zapcms\\" :"app/zapcms/",
      "mods\\" :"mods/"
    }
  },
  "minimum-stability": "dev"
}
